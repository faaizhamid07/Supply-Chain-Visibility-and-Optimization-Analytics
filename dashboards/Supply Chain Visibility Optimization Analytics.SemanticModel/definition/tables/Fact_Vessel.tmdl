table Fact_Vessel
	lineageTag: fc2baadb-161e-4912-af78-7554d5c17a8c

	measure 'Total AIS Records' = COUNTROWS(Fact_Vessel)
		formatString: 0
		lineageTag: bd31bc1d-58d1-4886-ab25-fcfff6a89189

		changedProperty = IsHidden

	measure 'Unique Vessels' = DISTINCTCOUNT(Fact_Vessel[MMSI])
		formatString: 0
		lineageTag: 6a945ba8-f647-4bfc-8582-ee8a45643e33

		changedProperty = IsHidden

	measure 'Average Speed (km/h)' = AVERAGE(Fact_Vessel[SOG_kmh])
		lineageTag: e666c6d0-43f9-4fe2-bbd0-46fa6e1ed2ab

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Distance (km)' = SUM(Fact_Vessel[dist_km])
		lineageTag: 9c93353d-0118-4515-9473-0d611be38a8b

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average ETA (hours)' = AVERAGE(Fact_Vessel[ETA_hours])
		lineageTag: 9ebd5cb0-295b-4666-b41f-14e3e0a8c88f

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stopped Records' =
			CALCULATE(
			    COUNTROWS(Fact_Vessel),
			    Fact_Vessel[Operational_Status] = "Stopped"
			)
		formatString: 0
		lineageTag: 8e1f30a8-8a3f-4c8c-a459-f7c872c8130d

		changedProperty = IsHidden

	measure 'Stopped AIS Records %' =
			DIVIDE(
			    [Stopped Records],
			    [Total AIS Records],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ca805f59-bd8b-4609-8043-f98048986f67

		changedProperty = IsHidden

	measure 'Average Visibility (km)' =
			
			AVERAGE(Fact_Vessel[weather_visibility_km])
		lineageTag: 5ffb1654-98e4-49f9-ad35-ac0d5ad42509

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Wind Speed (km/h)' =
			
			AVERAGE(Fact_Vessel[weather_wind_kph])
		lineageTag: f53a3458-b810-4e8f-919a-2fc05f5f3410

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cargo Movement Records' =
			
			CALCULATE(
			    COUNTROWS(Fact_Vessel),
			    Fact_Vessel[Operational_Status] = "Moving"
			)
		formatString: 0
		lineageTag: 2a4836a3-81ec-4156-a956-2c887bd0f606

		changedProperty = IsHidden

	measure 'Active Cargo Vessels' =
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_Vessel[MMSI]),
			    Fact_Vessel[Operational_Status] = "Moving"
			)
		formatString: 0
		lineageTag: f9e1a449-c50f-46f0-aede-ba1240ac62a0

		changedProperty = IsHidden

	measure 'Cargo Records per Active Vessel' =
			
			DIVIDE(
			    [Cargo Movement Records],
			    [Active Cargo Vessels],
			    0
			)
		lineageTag: 1c1573fa-44de-4ab6-ba69-aae9c2e8009c

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delayed Deliveries' =
			
			CALCULATE(
			    COUNTROWS(Fact_Vessel),
			    Fact_Vessel[ETA_hours] > 60
			)
		formatString: 0
		lineageTag: 9b4d04c3-fd56-4618-b675-57c6f0054b81

	measure 'On-Time Delivery %' =
			
			1 - DIVIDE([Delayed Deliveries],[Total AIS Records],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5846f72b-1762-4317-a863-fc7e86144bf6

	measure 'ETA Variance' =
			
			[Average ETA (hours)] - 59.89
		lineageTag: de541f4e-62d8-4184-b0bd-6b156b7e6146

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Transportation Cost Proxy' =
			
			SUM(Fact_Vessel[dist_km])
		lineageTag: 15717ade-175c-4928-943c-6d0a35669a87

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Shipment Cost Proxy' =
			
			AVERAGE(Fact_Vessel[dist_km])
		lineageTag: 1f82ddbe-f37d-4214-a2b1-2d08ea52e739

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fulfillment Rate' =
			
			DIVIDE(
			    [Cargo Movement Records],
			    [Total AIS Records],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a256dc3f-be5b-4f74-bf68-702e70f8200c

	measure 'On-Time Rate' =
			
			1 -
			DIVIDE(
			    [Delayed Deliveries],
			    [Total AIS Records],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f62f9e41-dec9-4ed4-ab3b-13805ae2c311

	measure 'Supplier Shipment Count' =
			
			COUNTROWS(Fact_Vessel)
		formatString: 0
		lineageTag: ee7c52a1-7b60-4c80-9725-b17fd0442463

	measure 'Supplier Quality Score' =
			
			VAR AvgETA =
			    AVERAGE(Fact_Vessel[ETA_hours])
			VAR Score =
			    100 -
			    DIVIDE(AvgETA, 2, 0)
			RETURN
			    MAX(0, MIN(100, Score))
		lineageTag: f6d3b5a2-a464-4bff-a33b-b1e344579ebc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Carrier Transportation Cost' =
			
			SUM(Fact_Vessel[dist_km])
		lineageTag: 8e9d1e26-ced1-4e9d-b25f-bcbaf67406e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Operational Utilization Proxy' =
			
			DIVIDE(
			    [Cargo Movement Records],
			    [Total AIS Records],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4b636ffa-0126-4d10-bb4f-429cb3a2371d

	measure Measure
		lineageTag: a95b5a75-a4f6-4e50-978f-14f048f6e853

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Moving AIS Records' =
			
			CALCULATE(
			    COUNTROWS(Fact_Vessel),
			    Fact_Vessel[Speed_Category] IN {"Fast", "Moderate", "Slow"}
			)
		formatString: 0
		lineageTag: 2cee8154-a9cd-4f9e-a36a-da8fc81661aa

	measure 'Average Delivery Time' = AVERAGE(Fact_Vessel[ETA_hours])
		lineageTag: 6e6e7c57-2103-40cc-8fc0-f4d572e57d81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

