	column 'Vessel Type Name' = ```
			
			VAR Code = IFERROR(VALUE(Fact_Vessel[VesselType]), -1)
			RETURN
			    SWITCH(
			        TRUE(),
			        Code = 0, "Not available",
			        Code = 30, "Fishing",
			        Code = 31 || Code = 32, "Towing",
			        Code = 33, "Dredging",
			        Code = 34, "Diving operations",
			        Code = 35, "Military",
			        Code = 36, "Sailing",
			        Code = 37, "Pleasure craft",
			        Code >= 50 && Code <= 59, "Special-purpose vessel",
			        Code >= 60 && Code <= 69, "Passenger vessel",
			        Code >= 70 && Code <= 79, "Cargo vessel",
			        Code >= 80 && Code <= 89, "Tanker",
			        Code >= 90 && Code <= 99, "Other vessel",
			        "Other / unclassified"
			    )
			
			```
		lineageTag: 956e3a0b-efbc-4451-a4bf-c587cd438282
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Hour of Day' = HOUR(Fact_Vessel[BaseDateTime])
