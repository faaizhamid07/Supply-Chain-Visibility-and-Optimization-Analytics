		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\ais_data_cleaned.csv"), [Delimiter = ",", Columns = 41, Encoding = 1252, QuoteStyle = QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
